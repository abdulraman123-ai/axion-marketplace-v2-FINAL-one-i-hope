# Supabase — from your project's Settings > API page.
# Real values go in .env.local (never this file) and in Vercel's
# Environment Variables settings. Both are needed since they don't sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects may call the same browser-safe key "publishable".
# The app accepts either NEXT_PUBLIC_SUPABASE_ANON_KEY or this value.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, bypasses every RLS rule — used by the checkout and webhook
# routes ONLY. Never prefix this with NEXT_PUBLIC_, and never expose it
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy — leave blank until your account is fully registered.
# The app builds and deploys fine with these empty; checkout will just
# return a clear "not configured yet" error until real values exist.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Email provider — leave blank until an email service is configured.
# The app sends purchase confirmation emails from the webhook route.
# Pick one provider and set the corresponding variables.
# Examples: Resend, SendGrid, Postmark, AWS SES, etc.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
